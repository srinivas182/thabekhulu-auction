# Thabekhulu Auctions — environment template. Never commit real secrets.
APP_NAME="Thabekhulu Development Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
DISPLAY_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose service names are used as hosts.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=thabekhulu
DB_USERNAME=thabekhulu
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@thabekhuludevelopment.org.za"
MAIL_FROM_NAME="${APP_NAME}"

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

# Inertia server-side rendering (ssr service in Docker Compose).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

# Platform
PUBLIC_SITE_INDEXING=false
CSP_ENABLED=true
CSP_REPORT_ONLY=false

VITE_APP_NAME="${APP_NAME}"

# First super admin (created by: php artisan db:seed)
SUPER_ADMIN_EMAIL=admin@thabekhuludevelopment.org.za
TERMS_VERSION=1.0

# Live auction feed (Laravel Reverb). Production: REVERB_HOST = the site's domain, REVERB_SCHEME=https, REVERB_PORT=443
# (nginx proxies /app to the reverb container). Generate the id, key and secret once per environment.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
